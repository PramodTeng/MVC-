@model Search 

<form method="post">
    <div class="border p-3 mt-4">
        <div class="row pb-2">
            <h2 class="text-primary">Add </h2>
        </div>
        <div asp-validation-summary="All"></div>
        <div class="mb-3">
            <label asp-for="Categories"> </label>
            <input asp-for="Categories" class="form-control" /> 
            <span asp-validation-for="Categories" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Sub_Category"> </label>
            <input asp-for="Sub_Category" class="form-control" />
            <span asp-validation-for="Sub_Category" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Instructor"> </label>
            <input asp-for="Instructor" class="form-control" />
            <span asp-validation-for="Instructor" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Class_Level"> </label>
            <input asp-for="Class_Level" class="form-control" />
            <span asp-validation-for="Class_Level" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary" style="width:150px">Submit</button>
        <a asp-controller="Search" asp-action="Index" class="btn btn-secondary" style="width:150px">
            Back to Section

        </a>
    </div>
</form>

@section Scripts{
    @{
        <partial name="_ValidationScriptsPartial.cshtml" />

    }
}