@model IEnumerable<Search>
@{
    ViewData["Title"] = "Index";
}


<div class="container p-3">
    <div class=" row pt-4">
        <div class="col-6">
            <h2 class="text-primary">Browse Section</h2> </div>
            <div class="col-6 text-end">
            <a asp-controller="Search" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> &nbsp; Add
            </a>
        </div>
    </div>
    <br /> <br />


<table class="table table-bordered table-striped" style="width:100%">
<thead>
    <tr>
    <th>Video Length </th>
    <th> Categories</th>
    <th> Sub-Categories</th>
    <th> Instructor</th>
    <th> Class Level</th>
    <th></th>
   </tr>
    </thead>
    <tbody> 

      @foreach(var obj in Model)
        {
            <tr>
                <td width="20%">
                    @obj.VideoLength
                </td>

                     <td width="40%">
                    @obj.Categories
                </td>

                     <td width="40%">
                    @obj.Sub_Category
                    </td>

                      <td width="40%">
                    @obj.Instructor
                    </td>

                         <td width="50%">
                    @obj.Class_Level
                    </td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Search" asp-action="Edit" asp-route-VideoLength="@obj.VideoLength"

                            class="btn btn-primary mx-2"><i class="bi bi-pencil-square"></i>Edit</a>
                        </div>

                    </td>
                    <td>
                        <div class="w-75 btn-group" role="group">
                            <a asp-controller="Search" asp-action="Delete" asp-route-VideoLength="@obj.VideoLength"
                           class="btn btn-primary mx-2"><i class="bi bi-trash"></i>Delete</a>
                        </div>

                    </td>
            </tr>
            
        }
       </tbody>

</table>
</div>